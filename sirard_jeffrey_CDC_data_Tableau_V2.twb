    <worksheet name='Scatter 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ&#10;</run>
            <run bold='false' fontcolor='#000000' fontname='Segoe UI' fontsize='11' italic='false' underline='false'>Are obesity and diabetes related?
</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PLACES__Local_Data_for_Better_Health,_County_Data,_2025_release_20261105' name='federated.04p5q5s16ni5sv173lowi1tfk6bw' />
