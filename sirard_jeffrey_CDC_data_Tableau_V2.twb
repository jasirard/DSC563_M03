    <worksheet name='Sheet 8'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>How do obesity and related chronic conditions (Diabetes, High Blood Pressure) differ between metropolitan and rural counties?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PLACES__Local_Data_for_Better_Health,_County_Data,_2025_release_20261105' name='federated.04p5q5s16ni5sv173lowi1tfk6bw' />
          </datasources>
          <datasource-dependencies datasource='federated.04p5q5s16ni5sv173lowi1tfk6bw'>
            <column caption='Prevalence: High BP' datatype='real' name='[Calculation_0498694308098056 1 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [MeasureId] = &quot;BPHIGH&quot; THEN [Data_Value] END)' />
            </column>
            <column caption='Prevalence: Obesity' datatype='real' name='[Calculation_0498694308098056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [MeasureId] = &quot;OBESITY&quot; THEN [Data_Value] END)' />
            </column>
            <column caption='Prevalence: Diabetes' datatype='real' name='[Calculation_0498694308159497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [MeasureId] = &quot;DIABETES&quot; THEN [Data_Value] END)' />
            </column>
            <column caption='Urban-Rural Classification' datatype='string' name='[Calculation_2003376230457345]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [TotalPopulation] &lt; 50000 THEN &quot;Rural&quot;&#13;&#10;ELSEIF [TotalPopulation] &lt;= 250000 THEN &quot;Suburban&quot;&#13;&#10;ELSE &quot;Metro&quot;&#13;&#10;END' />
            </column>
