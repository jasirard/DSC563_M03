            <column caption='Region' datatype='string' name='[Calculation_0498694297329670]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE UPPER(TRIM([StateAbbr]))&#13;&#10;WHEN &apos;CT&apos; THEN &apos;Northeast&apos;&#13;&#10;WHEN &apos;DE&apos; THEN &apos;Northeast&apos;&#13;&#10;WHEN &apos;MA&apos; THEN &apos;Northeast&apos;&#13;&#10;WHEN &apos;MD&apos; THEN &apos;Northeast&apos;&#13;&#10;WHEN &apos;ME&apos; THEN &apos;Northeast&apos;&#13;&#10;WHEN &apos;NH&apos; THEN &apos;Northeast&apos;&#13;&#10;WHEN &apos;NJ&apos; THEN &apos;Northeast&apos;&#13;&#10;WHEN &apos;NY&apos; THEN &apos;Northeast&apos;&#13;&#10;WHEN &apos;PA&apos; THEN &apos;Northeast&apos;&#13;&#10;WHEN &apos;RI&apos; THEN &apos;Northeast&apos;&#13;&#10;WHEN &apos;VT&apos; THEN &apos;Northeast&apos;&#13;&#10;WHEN &apos;DC&apos; THEN &apos;Northeast&apos;&#13;&#10;WHEN &apos;AL&apos; THEN &apos;Southeast&apos;&#13;&#10;WHEN &apos;AR&apos; THEN &apos;Southeast&apos;&#13;&#10;WHEN &apos;FL&apos; THEN &apos;Southeast&apos;&#13;&#10;WHEN &apos;GA&apos; THEN &apos;Southeast&apos;&#13;&#10;WHEN &apos;KY&apos; THEN &apos;Southeast&apos;&#13;&#10;WHEN &apos;LA&apos; THEN &apos;Southeast&apos;&#13;&#10;WHEN &apos;MS&apos; THEN &apos;Southeast&apos;&#13;&#10;WHEN &apos;NC&apos; THEN &apos;Southeast&apos;&#13;&#10;WHEN &apos;SC&apos; THEN &apos;Southeast&apos;&#13;&#10;WHEN &apos;TN&apos; THEN &apos;Southeast&apos;&#13;&#10;WHEN &apos;VA&apos; THEN &apos;Southeast&apos;&#13;&#10;WHEN &apos;WV&apos; THEN &apos;Southeast&apos;&#13;&#10;WHEN &apos;IA&apos; THEN &apos;Midwest&apos;&#13;&#10;WHEN &apos;IL&apos; THEN &apos;Midwest&apos;&#13;&#10;WHEN &apos;IN&apos; THEN &apos;Midwest&apos;&#13;&#10;WHEN &apos;KS&apos; THEN &apos;Midwest&apos;&#13;&#10;WHEN &apos;MI&apos; THEN &apos;Midwest&apos;&#13;&#10;WHEN &apos;MN&apos; THEN &apos;Midwest&apos;&#13;&#10;WHEN &apos;MO&apos; THEN &apos;Midwest&apos;&#13;&#10;WHEN &apos;ND&apos; THEN &apos;Midwest&apos;&#13;&#10;WHEN &apos;NE&apos; THEN &apos;Midwest&apos;&#13;&#10;WHEN &apos;OH&apos; THEN &apos;Midwest&apos;&#13;&#10;WHEN &apos;SD&apos; THEN &apos;Midwest&apos;&#13;&#10;WHEN &apos;WI&apos; THEN &apos;Midwest&apos;&#13;&#10;WHEN &apos;AZ&apos; THEN &apos;Southwest&apos;&#13;&#10;WHEN &apos;NM&apos; THEN &apos;Southwest&apos;&#13;&#10;WHEN &apos;OK&apos; THEN &apos;Southwest&apos;&#13;&#10;WHEN &apos;TX&apos; THEN &apos;Southwest&apos;&#13;&#10;WHEN &apos;AK&apos; THEN &apos;West&apos;&#13;&#10;WHEN &apos;CA&apos; THEN &apos;West&apos;&#13;&#10;WHEN &apos;CO&apos; THEN &apos;West&apos;&#13;&#10;WHEN &apos;HI&apos; THEN &apos;West&apos;&#13;&#10;WHEN &apos;ID&apos; THEN &apos;West&apos;&#13;&#10;WHEN &apos;MT&apos; THEN &apos;West&apos;&#13;&#10;WHEN &apos;NV&apos; THEN &apos;West&apos;&#13;&#10;WHEN &apos;OR&apos; THEN &apos;West&apos;&#13;&#10;WHEN &apos;UT&apos; THEN &apos;West&apos;&#13;&#10;WHEN &apos;WA&apos; THEN &apos;West&apos;&#13;&#10;WHEN &apos;WY&apos; THEN &apos;West&apos;&#13;&#10;ELSE &apos;Other / Unknown&apos;&#13;&#10;END' />
            </column>
            <column caption='Prevalence: Obesity' datatype='real' name='[Calculation_0498694308098056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [MeasureId] = &quot;OBESITY&quot; AND [DataValueTypeID] = &quot;CrdPrv&quot; AND [StateAbbr] != &quot;US&quot; &#13;&#10;THEN [Data_Value] &#13;&#10;END' />
            </column>
            <column caption='Population Class' datatype='string' name='[Calculation_2003376230457345]' role='dimension' type='nominal'>
